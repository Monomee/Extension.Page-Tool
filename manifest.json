{
  "manifest_version": 3,
  "name": "Page Tools",
  "version": "0.2.0",
  "description": "Bỏ chặn copy, chụp màn hình + ghi chú, OCR, dịch & tóm tắt ngay trên trang.",
  "permissions": [
    "activeTab",
    "scripting",
    "contextMenus",
    "storage",
    "offscreen",
    "cookies",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>",
    "*://*.studocu.com/*",
    "*://*.studocu.vn/*",
    "https://scribd.com/*",
    "https://*.scribd.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Page Tools"
  },
  "content_scripts": [
    {
      "matches": [
        "https://scribd.com/*",
        "https://*.scribd.com/*"
      ],
      "js": ["scribd-print.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "native-print.js",
        "native-print.css",
        "scribd-print.js"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "commands": {
    "region": { "suggested_key": { "default": "Alt+Shift+S" }, "description": "Chụp vùng màn hình" },
    "ocr": { "suggested_key": { "default": "Alt+Shift+O" }, "description": "Trích chữ vùng chọn" },
    "fullpage": { "suggested_key": { "default": "Alt+Shift+F" }, "description": "Chụp toàn trang" },
    "translate": { "suggested_key": { "default": "Alt+Shift+D" }, "description": "Dịch đoạn bôi đen" },
    "summarize": { "description": "Tóm tắt đoạn bôi đen" }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
